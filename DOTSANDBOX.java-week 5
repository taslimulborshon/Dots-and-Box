import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class DOTSANDBOX extends JFrame {

    static int n = 3;
    static boolean[][] h = new boolean[n + 1][n];
    static boolean[][] v = new boolean[n][n + 1];

    static int cellSize = 90;
    static int startX = 50;
    static int startY = 90;

    public DOTSANDBOX() {
        setTitle("Dots & Boxes - Week 5");
        setSize(500, 500);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        add(new GamePanel());

        setVisible(true);
    }

    class GamePanel extends JPanel {

        public GamePanel() {

            setBackground(new Color(235, 240, 250));

            addMouseListener(new MouseAdapter() {

                public void mousePressed(MouseEvent e) {
                    handleClick(e.getX(), e.getY());
                    repaint();
                }
            });
        }

        protected void paintComponent(Graphics g) {

            super.paintComponent(g);

            Graphics2D g2 = (Graphics2D) g;

            g2.setRenderingHint(
                    RenderingHints.KEY_ANTIALIASING,
                    RenderingHints.VALUE_ANTIALIAS_ON
            );

            g2.setColor(Color.WHITE);

            g2.fillRoundRect(
                    startX - 25,
                    startY - 25,
                    n * cellSize + 50,
                    n * cellSize + 50,
                    20,
                    20
            );

            g2.setStroke(new BasicStroke(5));

            g2.setColor(Color.DARK_GRAY);

            for (int i = 0; i <= n; i++) {

                for (int j = 0; j < n; j++) {

                    if (h[i][j]) {

                        int x1 = startX + j * cellSize;
                        int x2 = startX + (j + 1) * cellSize;
                        int y = startY + i * cellSize;

                        g2.drawLine(x1, y, x2, y);
                    }
                }
            }

            for (int i = 0; i < n; i++) {

                for (int j = 0; j <= n; j++) {

                    if (v[i][j]) {

                        int x = startX + j * cellSize;
                        int y1 = startY + i * cellSize;
                        int y2 = startY + (i + 1) * cellSize;

                        g2.drawLine(x, y1, x, y2);
                    }
                }
            }

            g2.setColor(Color.BLACK);

            for (int i = 0; i <= n; i++) {

                for (int j = 0; j <= n; j++) {

                    int x = startX + j * cellSize - 6;
                    int y = startY + i * cellSize - 6;

                    g2.fillOval(x, y, 12, 12);
                }
            }

            g2.setFont(new Font("Arial", Font.BOLD, 20));
            g2.drawString("Dots & Boxes", 175, 45);
        }
    }

    void handleClick(int x, int y) {

        double closestDistance = 18;

        int selectedRow = -1;
        int selectedCol = -1;
        boolean isHorizontal = false;

        for (int i = 0; i <= n; i++) {

            for (int j = 0; j < n; j++) {

                int x1 = startX + j * cellSize;
                int x2 = startX + (j + 1) * cellSize;
                int lineY = startY + i * cellSize;

                if (x >= x1 && x <= x2) {

                    double distance = Math.abs(y - lineY);

                    if (distance < closestDistance) {

                        closestDistance = distance;
                        selectedRow = i;
                        selectedCol = j;
                        isHorizontal = true;
                    }
                }
            }
        }

        for (int i = 0; i < n; i++) {

            for (int j = 0; j <= n; j++) {

                int lineX = startX + j * cellSize;
                int y1 = startY + i * cellSize;
                int y2 = startY + (i + 1) * cellSize;

                if (y >= y1 && y <= y2) {

                    double distance = Math.abs(x - lineX);

                    if (distance < closestDistance) {

                        closestDistance = distance;
                        selectedRow = i;
                        selectedCol = j;
                        isHorizontal = false;
                    }
                }
            }
        }

        if (selectedRow == -1) {
            return;
        }

        if (isHorizontal) {

            if (!h[selectedRow][selectedCol]) {
                h[selectedRow][selectedCol] = true;
            }

        } else {

            if (!v[selectedRow][selectedCol]) {
                v[selectedRow][selectedCol] = true;
            }
        }
    }

    public static void main(String[] args) {
        new DOTSANDBOX();
    }
}