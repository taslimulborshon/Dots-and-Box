import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class DOTSANDBOX extends JFrame {

    static int n = 3;

    static boolean[][] h = new boolean[n + 1][n];
    static boolean[][] v = new boolean[n][n + 1];
    static int[][] boxOwner = new int[n][n];

    static int p1 = 0;
    static int p2 = 0;
    static int player = 1;
    static boolean gameOver = false;

    static int cellSize = 110;
    static int startX = 45;
    static int startY = 60;

    JLabel scoreLabel;
    JLabel turnLabel;
    JButton restartButton;

    public DOTSANDBOX() {

        setTitle("Dots & Boxes");
        setSize(450, 500);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        JPanel topPanel = new JPanel(new BorderLayout());

        topPanel.setBorder(
                BorderFactory.createEmptyBorder(
                        8, 8, 8, 8
                )
        );

        topPanel.setBackground(
                new Color(245, 247, 255)
        );

        scoreLabel = new JLabel(
                "Player 1: 0   Player 2: 0"
        );

        scoreLabel.setFont(
                new Font(
                        "Arial",
                        Font.BOLD,
                        13
                )
        );

        turnLabel = new JLabel(
                "Turn: Player 1",
                SwingConstants.CENTER
        );

        turnLabel.setFont(
                new Font(
                        "Arial",
                        Font.BOLD,
                        13
                )
        );

        restartButton = new JButton(
                "Restart Game"
        );

        restartButton.setFont(
                new Font(
                        "Arial",
                        Font.BOLD,
                        12
                )
        );

        restartButton.setFocusPainted(false);

        restartButton.addActionListener(
                e -> restartGame()
        );

        topPanel.add(
                scoreLabel,
                BorderLayout.WEST
        );

        topPanel.add(
                turnLabel,
                BorderLayout.CENTER
        );

        topPanel.add(
                restartButton,
                BorderLayout.EAST
        );

        add(
                topPanel,
                BorderLayout.NORTH
        );

        GamePanel panel = new GamePanel();

        add(
                panel,
                BorderLayout.CENTER
        );

        setVisible(true);
    }

    class GamePanel extends JPanel {

        public GamePanel() {

            setOpaque(true);

            addMouseListener(
                    new MouseAdapter() {

                        @Override
                        public void mousePressed(
                                MouseEvent e
                        ) {

                            if (!gameOver) {

                                handleClick(
                                        e.getX(),
                                        e.getY()
                                );
                            }
                        }
                    }
            );
        }

        @Override
        protected void paintComponent(
                Graphics g
        ) {

            super.paintComponent(g);

            Graphics2D g2 =
                    (Graphics2D) g;

            g2.setRenderingHint(
                    RenderingHints.KEY_ANTIALIASING,
                    RenderingHints.VALUE_ANTIALIAS_ON
            );

            int width = getWidth();
            int height = getHeight();

            GradientPaint gradient =
                    new GradientPaint(
                            0,
                            0,
                            new Color(
                                    235,
                                    240,
                                    255
                            ),
                            width,
                            height,
                            new Color(
                                    255,
                                    245,
                                    250
                            )
                    );

            g2.setPaint(gradient);

            g2.fillRect(
                    0,
                    0,
                    width,
                    height
            );

            g2.setColor(
                    new Color(
                            255,
                            255,
                            255,
                            150
                    )
            );

            g2.fillRoundRect(
                    20,
                    15,
                    410,
                    400,
                    25,
                    25
            );

            for (int i = 0; i < n; i++) {

                for (int j = 0; j < n; j++) {

                    int x =
                            startX +
                            j * cellSize;

                    int y =
                            startY +
                            i * cellSize;

                    if (boxOwner[i][j] == 1) {

                        g2.setColor(
                                new Color(
                                        255,
                                        90,
                                        100
                                )
                        );

                        g2.fillRoundRect(
                                x + 4,
                                y + 4,
                                cellSize - 8,
                                cellSize - 8,
                                15,
                                15
                        );

                    } else if (boxOwner[i][j] == 2) {

                        g2.setColor(
                                new Color(
                                        90,
                                        110,
                                        255
                                )
                        );

                        g2.fillRoundRect(
                                x + 4,
                                y + 4,
                                cellSize - 8,
                                cellSize - 8,
                                15,
                                15
                        );
                    }
                }
            }

            g2.setStroke(
                    new BasicStroke(4)
            );

            g2.setColor(Color.BLACK);

            for (int i = 0; i <= n; i++) {

                for (int j = 0; j <= n; j++) {

                    int x =
                            startX +
                            j * cellSize;

                    int y =
                            startY +
                            i * cellSize;

                    g2.fillOval(
                            x - 7,
                            y - 7,
                            14,
                            14
                    );
                }
            }

            for (int i = 0; i <= n; i++) {

                for (int j = 0; j < n; j++) {

                    if (h[i][j]) {

                        int x1 =
                                startX +
                                j * cellSize;

                        int y =
                                startY +
                                i * cellSize;

                        int x2 =
                                startX +
                                (j + 1) *
                                cellSize;

                        g2.setColor(
                                Color.BLACK
                        );

                        g2.drawLine(
                                x1,
                                y,
                                x2,
                                y
                        );
                    }
                }
            }

            for (int i = 0; i < n; i++) {

                for (int j = 0; j <= n; j++) {

                    if (v[i][j]) {

                        int x =
                                startX +
                                j * cellSize;

                        int y1 =
                                startY +
                                i * cellSize;

                        int y2 =
                                startY +
                                (i + 1) *
                                cellSize;

                        g2.setColor(
                                Color.BLACK
                        );

                        g2.drawLine(
                                x,
                                y1,
                                x,
                                y2
                        );
                    }
                }
            }

            if (gameOver) {

                g2.setColor(
                        new Color(
                                255,
                                255,
                                255,
                                225
                        )
                );

                g2.fillRoundRect(
                        60,
                        170,
                        330,
                        120,
                        25,
                        25
                );

                g2.setColor(Color.BLACK);

                g2.setFont(
                        new Font(
                                "Arial",
                                Font.BOLD,
                                22
                        )
                );

                g2.drawString(
                        "GAME OVER",
                        150,
                        205
                );

                String result;

                if (p1 > p2) {

                    result =
                            "Player 1 Wins!";

                } else if (p2 > p1) {

                    result =
                            "Player 2 Wins!";

                } else {

                    result =
                            "Game Draw!";
                }

                g2.setFont(
                        new Font(
                                "Arial",
                                Font.BOLD,
                                17
                        )
                );

                g2.drawString(
                        result,
                        150,
                        240
                );

                g2.setFont(
                        new Font(
                                "Arial",
                                Font.PLAIN,
                                14
                        )
                );

                g2.drawString(
                        "Click Restart Game to play again",
                        120,
                        268
                );
            }
        }
    }

    void handleClick(
            int x,
            int y
    ) {

        int relativeX =
                x - startX;

        int relativeY =
                y - startY;

        if (relativeX < 0 ||
                relativeY < 0) {

            return;
        }

        int col =
                relativeX / cellSize;

        int row =
                relativeY / cellSize;

        int dx =
                relativeX % cellSize;

        int dy =
                relativeY % cellSize;

        boolean moveMade = false;

        if (dy <= 15 &&
                row >= 0 &&
                row <= n &&
                col >= 0 &&
                col < n) {

            if (!h[row][col]) {

                h[row][col] = true;

                moveMade = true;
            }
        }

        else if (
                dx <= 15 &&
                row >= 0 &&
                row < n &&
                col >= 0 &&
                col <= n
        ) {

            if (!v[row][col]) {

                v[row][col] = true;

                moveMade = true;
            }
        }

        if (!moveMade) {

            return;
        }

        int got =
                checkBoxes();

        if (got > 0) {

            if (player == 1) {

                p1 += got;

            } else {

                p2 += got;
            }

        } else {

            player =
                    3 - player;
        }

        if (gameFinished()) {

            gameOver = true;
        }

        updateUI();

        repaint();
    }

    int checkBoxes() {

        int count = 0;

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (
                        boxOwner[i][j] == 0 &&
                        h[i][j] &&
                        h[i + 1][j] &&
                        v[i][j] &&
                        v[i][j + 1]
                ) {

                    boxOwner[i][j] =
                            player;

                    count++;
                }
            }
        }

        return count;
    }

    boolean gameFinished() {

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (boxOwner[i][j] == 0) {

                    return false;
                }
            }
        }

        return true;
    }

    void updateUI() {

        scoreLabel.setText(
                "Player 1: " +
                p1 +
                "   Player 2: " +
                p2
        );

        if (!gameOver) {

            turnLabel.setText(
                    "Turn: Player " +
                    player
            );

        } else {

            turnLabel.setText(
                    "Game Over"
            );
        }

        if (player == 1) {

            turnLabel.setForeground(
                    new Color(
                            220,
                            50,
                            60
                    )
            );

        } else {

            turnLabel.setForeground(
                    new Color(
                            50,
                            80,
                            220
                    )
            );
        }
    }

    void restartGame() {

        for (int i = 0;
             i < n + 1;
             i++) {

            for (int j = 0;
                 j < n;
                 j++) {

                h[i][j] = false;
            }
        }

        for (int i = 0;
             i < n;
             i++) {

            for (int j = 0;
                 j < n + 1;
                 j++) {

                v[i][j] = false;
            }
        }

        for (int i = 0;
             i < n;
             i++) {

            for (int j = 0;
                 j < n;
                 j++) {

                boxOwner[i][j] = 0;
            }
        }

        p1 = 0;
        p2 = 0;
        player = 1;
        gameOver = false;

        updateUI();

        repaint();
    }

    public static void main(
            String[] args
    ) {

        SwingUtilities.invokeLater(
                () -> new DOTSANDBOX()
        );
    }
}