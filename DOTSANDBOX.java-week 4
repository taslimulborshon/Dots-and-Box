import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

public class DOTSANDBOX extends JFrame {

    static int n = 3;

    static boolean[][] h = new boolean[n + 1][n];
    static boolean[][] v = new boolean[n][n + 1];

    static int cellSize = 80;
    static int startX = 60;
    static int startY = 85;

    static int selectedRow = -1;
    static int selectedCol = -1;

    public DOTSANDBOX() {

        setTitle("Dots & Boxes");
        setSize(450, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        add(new GamePanel());

        setVisible(true);
    }

    class GamePanel extends JPanel {

        public GamePanel() {

            addMouseListener(new MouseAdapter() {

                public void mousePressed(MouseEvent e) {

                    handleClick(e.getX(), e.getY());
                    repaint();
                }
            });
        }

        protected void paintComponent(Graphics g) {

            super.paintComponent(g);

            Graphics2D g2 = (Graphics2D) g;

            g2.setRenderingHint(
                    RenderingHints.KEY_ANTIALIASING,
                    RenderingHints.VALUE_ANTIALIAS_ON
            );

            int width = getWidth();
            int height = getHeight();

            GradientPaint gradient = new GradientPaint(
                    0, 0,
                    new Color(235, 240, 255),
                    width, height,
                    new Color(255, 245, 250)
            );

            g2.setPaint(gradient);
            g2.fillRect(0, 0, width, height);

            g2.setColor(new Color(255, 255, 255, 100));

            for (int x = 15; x < width; x += 30) {

                for (int y = 70; y < height; y += 30) {

                    g2.fillOval(x, y, 3, 3);
                }
            }

            g2.setColor(new Color(255, 255, 255, 180));

            g2.fillRoundRect(
                    15,
                    65,
                    420,
                    300,
                    25,
                    25
            );

            g2.setStroke(new BasicStroke(4));

       
            for (int i = 0; i <= n; i++) {

                for (int j = 0; j < n; j++) {

                    if (h[i][j]) {

                        int x1 = startX + j * cellSize;
                        int y = startY + i * cellSize;
                        int x2 = startX + (j + 1) * cellSize;

                        g2.setColor(Color.BLACK);

                        g2.drawLine(
                                x1,
                                y,
                                x2,
                                y
                        );
                    }
                }
            }

            
            for (int i = 0; i < n; i++) {

                for (int j = 0; j <= n; j++) {

                    if (v[i][j]) {

                        int x = startX + j * cellSize;
                        int y1 = startY + i * cellSize;
                        int y2 = startY + (i + 1) * cellSize;

                        g2.setColor(Color.BLACK);

                        g2.drawLine(
                                x,
                                y1,
                                x,
                                y2
                        );
                    }
                }
            }

           
            for (int i = 0; i <= n; i++) {

                for (int j = 0; j <= n; j++) {

                    int x = startX + j * cellSize;
                    int y = startY + i * cellSize;

                    if (i == selectedRow &&
                            j == selectedCol) {

                        g2.setColor(Color.RED);

                        g2.fillOval(
                                x - 8,
                                y - 8,
                                16,
                                16
                        );

                    } else {

                        g2.setColor(Color.BLACK);

                        g2.fillOval(
                                x - 5,
                                y - 5,
                                10,
                                10
                        );
                    }
                }
            }

            g2.setColor(Color.BLACK);

            g2.setFont(
                    new Font(
                            "Arial",
                            Font.BOLD,
                            22
                    )
            );

            g2.drawString(
                    "Dots & Boxes",
                    145,
                    35
            );

            g2.setFont(
                    new Font(
                            "Arial",
                            Font.PLAIN,
                            14
                    )
            );

            if (selectedRow == -1) {

                g2.drawString(
                        "Select two nearby dots",
                        145,
                        385
                );

            } else {

                g2.drawString(
                        "Select the next dot",
                        155,
                        385
                );
            }
        }
    }

    void handleClick(int x, int y) {

        int relativeX = x - startX;
        int relativeY = y - startY;

        if (relativeX < 0 || relativeY < 0) {
            return;
        }

        int col = Math.round(
                (float) relativeX / cellSize
        );

        int row = Math.round(
                (float) relativeY / cellSize
        );

        if (row < 0 || row > n ||
                col < 0 || col > n) {

            return;
        }

        int dotX = startX + col * cellSize;
        int dotY = startY + row * cellSize;

        double distance = Math.sqrt(
                Math.pow(x - dotX, 2) +
                Math.pow(y - dotY, 2)
        );

        if (distance > 15) {
            return;
        }

        if (selectedRow == -1) {

            selectedRow = row;
            selectedCol = col;

        } else {

            int rowDifference =
                    Math.abs(row - selectedRow);

            int colDifference =
                    Math.abs(col - selectedCol);

            if (rowDifference + colDifference == 1) {

                if (row == selectedRow) {

                    int lineRow = row;

                    int lineCol =
                            Math.min(
                                    col,
                                    selectedCol
                            );

                    if (!h[lineRow][lineCol]) {

                        h[lineRow][lineCol] = true;
                    }

                } else {

                    int lineRow =
                            Math.min(
                                    row,
                                    selectedRow
                            );

                    int lineCol = col;

                    if (!v[lineRow][lineCol]) {

                        v[lineRow][lineCol] = true;
                    }
                }
            }

            selectedRow = -1;
            selectedCol = -1;
        }
    }

    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {
            new DOTSANDBOX();
        });
    }
}